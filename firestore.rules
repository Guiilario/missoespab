rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Só existe pra marcar quem é administrador. O documento admins/{uid}
    // precisa ser criado manualmente pelo dono do projeto no Console do
    // Firebase (Firestore Database → Data → iniciar coleção "admins" →
    // documento com o UID do admin como ID; o conteúdo do documento não
    // importa, só a existência dele). Não é criável pelo app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Qualquer usuário logado pode ler perfis (necessário pro ranking).
    // Um usuário só edita o próprio perfil — admin pode editar/criar
    // qualquer perfil (usado pra criar contas e ativar/desativar acesso).
    // Não existe delete de verdade: "remover" um usuário = marcar
    // disabled:true, que barra o login dele no app (ver js/auth-guard.js).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // Catálogo de missões: qualquer usuário logado lê, só admin escreve.
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Missão(ões) do dia — um documento POR DATA (não por usuário), vale
    // pra todo mundo. Qualquer usuário logado lê, só admin escreve.
    match /dailyAssignments/{date} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Mission completions: a user can create their own completion record
    // (id is uid_missionId_date so duplicates are naturally prevented),
    // but never edit or delete one after the fact.
    match /missionCompletions/{completionId} {
      allow read: if request.auth != null &&
        completionId.matches(request.auth.uid + '_.*');
      allow create: if request.auth != null &&
        completionId.matches(request.auth.uid + '_.*') &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Logs de missões repetíveis (Adesivagem, Panfletagem, convites).
    // Cada usuário só pode criar e ler seus próprios logs.
    match /missionLogs/{logId} {
      allow read: if request.auth != null &&
        (isAdmin() || logId.matches(request.auth.uid + '_.*'));
      allow create: if request.auth != null &&
        logId.matches(request.auth.uid + '_.*') &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Voluntários indicados por um usuário, cadastrados pela própria pessoa
    // convidada através do link público (convite.html) — por isso a escrita
    // não exige login. Cada usuário só pode LER os voluntários que ele mesmo
    // indicou (admin pode ler tudo). Sem update/delete: uma vez enviado, o
    // registro é definitivo.
    //
    // Aviso: como é um formulário público sem autenticação, ele está sujeito
    // a spam/abuso (alguém pode enviar várias entradas manualmente). Se isso
    // virar problema, considere adicionar Firebase App Check ou um captcha
    // na página convite.html.
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null &&
        (resource.data.inviterUid == request.auth.uid || isAdmin());
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'whatsapp', 'inviterUid', 'date', 'createdAt']
        ) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.inviterUid is string &&
        request.resource.data.inviterUid.size() > 0 &&
        request.resource.data.whatsapp is string &&
        request.resource.data.whatsapp.size() < 40;
      allow update, delete: if false;
    }
  }
}
