rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile (needed for ranking) but only write their own.
    // totalXp / completedMissionsCount / streak fields should only ever be
    // changed via the transactions in lib/firestore.js (completeMission,
    // markDayCompleted) — consider locking those fields down further with
    // Cloud Functions if you want to fully prevent client-side tampering.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Missions are managed by an admin/CMS; all signed-in users can read them.
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if false; // write from CMS/admin SDK only
    }

    // Daily assignments are generated server-side (CMS/Cloud Function);
    // each user can only read their own.
    match /dailyAssignments/{assignmentId} {
      allow read: if request.auth != null &&
        assignmentId.matches(request.auth.uid + '_.*');
      allow write: if false;
    }

    // Mission completions: a user can create their own completion record
    // (id is uid_missionId_date so duplicates are naturally prevented),
    // but never edit or delete one after the fact.
    match /missionCompletions/{completionId} {
      allow read: if request.auth != null &&
        completionId.matches(request.auth.uid + '_.*');
      allow create: if request.auth != null &&
        completionId.matches(request.auth.uid + '_.*') &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Voluntários indicados por um usuário, cadastrados pela própria pessoa
    // convidada através do link público (convite.html) — por isso a escrita
    // não exige login. Cada usuário só pode LER os voluntários que ele mesmo
    // indicou. Sem update/delete: uma vez enviado, o registro é definitivo.
    //
    // Aviso: como é um formulário público sem autenticação, ele está sujeito
    // a spam/abuso (alguém pode enviar várias entradas manualmente). Se isso
    // virar problema, considere adicionar Firebase App Check ou um captcha
    // na página convite.html.
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null &&
        resource.data.inviterUid == request.auth.uid;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'whatsapp', 'inviterUid', 'date', 'createdAt']
        ) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.inviterUid is string &&
        request.resource.data.inviterUid.size() > 0 &&
        request.resource.data.whatsapp is string &&
        request.resource.data.whatsapp.size() < 40;
      allow update, delete: if false;
    }
  }
}
